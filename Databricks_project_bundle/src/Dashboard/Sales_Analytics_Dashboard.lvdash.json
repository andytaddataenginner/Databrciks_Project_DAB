{
  "datasets": [
    {
      "name": "ec31fab8",
      "displayName": "dim_customer",
      "config": {
        "version": "1.1",
        "source": "youtube_dev.gold.dim_customer",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "customer_count",
            "expr": "COUNT(DISTINCT customer_id)",
            "displayName": "Customer Count"
          }
        ]
      }
    },
    {
      "name": "3c9923b2",
      "displayName": "dim_product",
      "config": {
        "version": "1.1",
        "source": "youtube_dev.gold.dim_product",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "product_count",
            "expr": "COUNT(DISTINCT product_id)",
            "displayName": "Product Count"
          }
        ]
      }
    },
    {
      "name": "1db3fb9f",
      "displayName": "fact_sales",
      "config": {
        "version": "1.1",
        "source": "youtube_dev.gold.fact_sales",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "total_sales",
            "expr": "SUM(net_sales)",
            "displayName": "Total Sales"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(quantity)",
            "displayName": "Total Quantity"
          },
          {
            "name": "order_count",
            "expr": "COUNT(DISTINCT order_id)",
            "displayName": "Order Count"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(net_sales) / COUNT(DISTINCT order_id)",
            "displayName": "Average Order Value"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "dim_customer",
          "datasetName": "ec31fab8"
        },
        {
          "name": "dim_product",
          "datasetName": "3c9923b2"
        },
        {
          "name": "fact_sales",
          "datasetName": "1db3fb9f"
        }
      ],
      "relationships": [
        {
          "name": "relationship_0",
          "from": "fact_sales",
          "to": "dim_customer",
          "on": "`fact_sales`.`customer_id` = `dim_customer`.`customer_id`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        },
        {
          "name": "relationship_1",
          "from": "fact_sales",
          "to": "dim_product",
          "on": "`fact_sales`.`product_id` = `dim_product`.`product_id`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ],
      "measureExpressions": [
        {
          "name": "revenue_per_customer",
          "expression": "MEASURE(`fact_sales`.`total_sales`) / MEASURE(`dim_customer`.`customer_count`)"
        },
        {
          "name": "revenue_per_product",
          "expression": "MEASURE(`fact_sales`.`total_sales`) / MEASURE(`dim_product`.`product_count`)"
        }
      ]
    }
  ],
